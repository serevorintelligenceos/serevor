+// Keeps long material within budget: start + middle + end, so a 1-hour video still covers all of it.
+function sample(text: string, max: number): { text: string; truncated: boolean } {
+  if (text.length <= max) return { text, truncated: false };
+  const a = Math.floor(max * 0.45), c = Math.floor(max * 0.3), b = max - a - c;
+  const mid = Math.floor(text.length / 2) - Math.floor(c / 2);
+  return { text: text.slice(0, a) + "\n[…]\n" + text.slice(mid, mid + c) + "\n[…]\n" + text.slice(text.length - b), truncated: true };
