+  return btoa(bin);
+}
+// The text read from images is stored inside item.content between two marker lines, so it is
+// searchable and visible to the user. This removes the old block before a fresh one is written.
+function stripSlideBlock(s: string): string {
+  const a = s.indexOf(SLIDES_START);
+  if (a < 0) return s.trim();
+  const b = s.indexOf(SLIDES_END, a);
+  return (s.slice(0, a) + (b >= 0 ? s.slice(b + SLIDES_END.length) : "")).trim();
+}
+// Only POSTS (a picture or carousel you can read), not reels/videos, are worth reading the cover image of.
+function isImagePostUrl(url: string, platform: string): boolean {
+  try {
+    const p = new URL(url).pathname.toLowerCase();
+    if (platform === "instagram") return /\/p\/[\w-]+/.test(p);
+    if (platform === "facebook") return !/\/(reel|reels|watch|videos?)\b/.test(p) && p.length > 1;
+    if (platform === "linkedin") return /\/(posts|feed\/update)\//.test(p);
+    if (platform === "x") return /\/status\/\d+/.test(p);
+    if (platform === "pinterest") return /\/pin\//.test(p);
+    return false;
+  } catch { return false; }
+}
+// Slide paths come from the item row, which the user can edit through the API: keep only their own images.
+function validSlidePaths(raw: unknown, userId: string): string[] {
+  if (!Array.isArray(raw)) return [];
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const p of raw) {
+    if (typeof p === "string" && p.startsWith(`${userId}/`) && !p.includes("..") && IMAGE_PATH.test(p) && !seen.has(p)) {
+      seen.add(p); out.push(p);
+    }
+  }
+  return out.slice(0, MAX_SLIDES);
