+import { createClient } from "jsr:@supabase/supabase-js@2";
+
+// ---------------------------------------------------------------------------
+// capture-analyze: Smart Capture's brain. Turns a captured item (link, reel, note,
+// voice/recording transcript, file) into structured, searchable knowledge, and files it
+// into a collection.
+//
+// Differences from the old extract-content:
+//  - reads the FULL article text (structure preserved), not a 7k-char blob
+//  - YouTube: full description + captions/transcript when YouTube serves them
+//  - Instagram/TikTok: cleans the og: caption; real understanding comes from a transcript
+//    the user adds (screen recording / voice) - no third-party extractor involved
+//  - richer structured output (tl;dr, steps, insights, actions, tools, why it matters)
+//  - reports HOW WELL it understood the item (full / partial / minimal) and from what
+//  - NEVER overwrites parts the user has edited by hand (insights.locked)
+//  - POSTS & CAROUSELS: reads every slide image (uploaded screenshots, or the post's cover image taken
+//    from its link) with a vision model, so the result is based on what the post actually says
+//  - Free vs Pro is decided by billing_is_pro() (checked against now()), never by the stale is_active flag
+// ---------------------------------------------------------------------------
+
+const GROQ_URL = "https://api.groq.com/openai/v1/chat/completions";
+const RETIRED = new Set(["llama-3.1-8b-instant", "llama-3.3-70b-versatile", "qwen/qwen3-32b", "meta-llama/llama-4-scout-17b-16e-instruct"]);
+const envModel = Deno.env.get("GROQ_EXTRACT_MODEL") || Deno.env.get("GROQ_MODEL");
+const MODEL = envModel && !RETIRED.has(envModel) ? envModel : "openai/gpt-oss-20b";
+
+const LIMIT = { free: 10, pro: 100, perMin: 10 }; // captures per day (keep in sync with src/lib/billing/plans.js CAPTURE)
+const MATERIAL_MAX = 30000; // chars sent to the model
+const CORS = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+};
+const CATEGORIES = [
+  "AI & Tools", "SEO & Marketing", "Business Strategy", "Finance", "Productivity",
+  "Personal Development", "Learning", "Tech & Coding", "Design & Creativity",
+  "Health & Fitness", "Career", "Lifestyle", "Uncategorized",
+];
+const SOCIAL = new Set(["instagram", "tiktok", "facebook"]);
+
+// ---- vision: reading the images of a post ----
+const MAX_SLIDES = 10;             // keep in sync with my_capture_quota().max_slides and src/lib/capture.js
+const VISION_BATCH = 3;            // Groq allows at most 3 images per request for its vision model
+const MAX_IMAGE_BYTES = 4_000_000; // per image (the app shrinks screenshots long before this)
+const SLIDE_MAX_CHARS = 1400;      // stored text per slide
+const SLIDES_START = "— Text read from the post's images —";
+const SLIDES_END = "— end of image text —";
+const IMAGE_PATH = /\.(png|jpe?g|webp|gif)$/i;
+// Groq renames its vision models every few months, so the model is configurable and falls back in order.
+function visionModels(): string[] {
+  const fromEnv = Deno.env.get("GROQ_VISION_MODEL")?.trim();
+  return [...new Set([fromEnv, "qwen/qwen3.8-27b", "qwen/qwen3.6-27b"].filter((m): m is string => !!m && !RETIRED.has(m)))];
+}
+
+const json = (b: unknown, s = 200) =>
+  new Response(JSON.stringify(b), { status: s, headers: { ...CORS, "Content-Type": "application/json" } });
+
+// ---------- SSRF-safe fetching (users give us URLs; we must never reach internal systems) ----------
+function isPrivateIp(ip: string): boolean {
+  if (ip.includes(":")) {
+    const l = ip.toLowerCase();
+    return l === "::1" || l === "::" || l.startsWith("fc") || l.startsWith("fd") || l.startsWith("fe80") || l.startsWith("::ffff:");
+  }
+  const p = ip.split(".").map(Number);
+  if (p.length !== 4 || p.some((n) => Number.isNaN(n))) return true;
+  const [a, b] = p;
+  return a === 0 || a === 10 || a === 127 || (a === 169 && b === 254) || (a === 172 && b >= 16 && b <= 31) ||
+    (a === 192 && b === 168) || (a === 100 && b >= 64 && b <= 127) || a >= 224;
+}
+async function assertPublicHost(u: URL) {
+  if (u.protocol !== "http:" && u.protocol !== "https:") throw new Error("Only http(s) links are supported");
+  const host = u.hostname.toLowerCase().replace(/^\[|\]$/g, "");
+  if (host === "localhost" || host.endsWith(".local") || host.endsWith(".internal") || host.endsWith(".localhost")) {
+    throw new Error("Blocked address");
+  }
+  if (/^[\d.]+$/.test(host) || host.includes(":")) {
+    if (isPrivateIp(host)) throw new Error("Blocked address");
+    return;
+  }
+  const ips: string[] = [];
+  const errs: unknown[] = [];
+  for (const type of ["A", "AAAA"] as const) {
+    try { ips.push(...await Deno.resolveDns(host, type)); } catch (e) { errs.push(e); }
+  }
+  if (ips.some(isPrivateIp)) throw new Error("Blocked address");
+  // A definite "no such host" is an error; if DNS lookups are simply unavailable in this runtime we continue.
+  if (!ips.length && errs.length === 2 && errs.every((e) => e instanceof Deno.errors.NotFound)) {
+    throw new Error("Could not resolve host");
+  }
+}
+async function safeFetchRaw(url: string, headers: Record<string, string> = {}, maxBytes = 1_500_000, timeoutMs = 9000) {
+  let current = new URL(url);
+  for (let hop = 0; hop < 5; hop++) {
+    await assertPublicHost(current);
+    const res = await fetch(current, {
+      redirect: "manual",
+      signal: AbortSignal.timeout(timeoutMs),
+      headers: { "User-Agent": "Mozilla/5.0 (compatible; SerevorBot/1.0)", "Accept-Language": "en", ...headers },
+    });
+    const loc = res.headers.get("location");
+    if (res.status >= 300 && res.status < 400 && loc) { current = new URL(loc, current); continue; }
+    const reader = res.body?.getReader();
+    const chunks: Uint8Array[] = [];
+    let total = 0;
+    if (reader) {
+      while (total < maxBytes) {
+        const { done, value } = await reader.read();
+        if (done || !value) break;
+        chunks.push(value); total += value.length;
+      }
+      try { await reader.cancel(); } catch { /* ignore */ }
+    }
+    const buf = new Uint8Array(total);
+    let off = 0;
+    for (const c of chunks) { buf.set(c, off); off += c.length; }
+    return { status: res.status, finalUrl: current.toString(), type: res.headers.get("content-type") || "", buf };
+  }
+  throw new Error("Too many redirects");
+}
+async function safeFetch(url: string, headers: Record<string, string> = {}, maxBytes = 1_500_000, timeoutMs = 9000) {
+  const r = await safeFetchRaw(url, headers, maxBytes, timeoutMs);
+  return { status: r.status, finalUrl: r.finalUrl, type: r.type, text: new TextDecoder().decode(r.buf) };
+}
+
+// ---------- HTML helpers ----------
+const decode = (s: string) =>
+  s.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#0?39;|&apos;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
+    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)))
+    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n))).replace(/&nbsp;/g, " ");
+function metaTag(html: string, key: string): string {
+  const k = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const a = html.match(new RegExp(`<meta[^>]+(?:property|name)=["']${k}["'][^>]*?content=["']([^"']*)["']`, "i"));
+  const b = html.match(new RegExp(`<meta[^>]+content=["']([^"']*)["'][^>]*?(?:property|name)=["']${k}["']`, "i"));
+  return decode((a?.[1] || b?.[1] || "").trim());
+}
+
+// Readable text with structure kept (headings, list items, paragraphs) so the model can follow the article.
+function structuredText(fragment: string): string {
+  return decode(
+    fragment
+      .replace(/<script[\s\S]*?<\/script>/gi, " ").replace(/<style[\s\S]*?<\/style>/gi, " ")
+      .replace(/<noscript[\s\S]*?<\/noscript>/gi, " ").replace(/<svg[\s\S]*?<\/svg>/gi, " ")
+      .replace(/<(nav|header|footer|aside|form|button)[\s\S]*?<\/\1>/gi, " ")
+      .replace(/<h[1-6][^>]*>/gi, "\n\n## ").replace(/<li[^>]*>/gi, "\n- ")
+      .replace(/<\/(p|div|section|article|tr|h[1-6]|ul|ol|blockquote)>/gi, "\n").replace(/<br\s*\/?>/gi, "\n")
+      .replace(/<[^>]+>/g, " "),
+  )
+    .replace(/[ \t\r\f\v]+/g, " ").replace(/ ?\n ?/g, "\n").replace(/\n{3,}/g, "\n\n").trim();
+}
+// Best-effort main-content extraction: JSON-LD articleBody > <article> > <main> > whole page.
+function articleText(html: string): string {
+  for (const m of html.matchAll(/<script[^>]+type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi)) {
+    try {
+      const walk = (n: unknown): string => {
+        if (Array.isArray(n)) return n.map(walk).find((s) => s.length > 400) || "";
+        if (n && typeof n === "object") {
+          const o = n as Record<string, unknown>;
+          if (typeof o.articleBody === "string" && o.articleBody.length > 400) return o.articleBody;
+          return Object.values(o).map(walk).find((s) => s.length > 400) || "";
+        }
+        return "";
+      };
+      const body = walk(JSON.parse(m[1]));
+      if (body) return decode(body).replace(/\s+/g, " ").trim();
+    } catch { /* ignore bad JSON-LD */ }
+  }
+  const pick = html.match(/<article[\s\S]*?<\/article>/i)?.[0] || html.match(/<main[\s\S]*?<\/main>/i)?.[0];
+  const fromPick = pick ? structuredText(pick) : "";
+  return fromPick.length > 600 ? fromPick : structuredText(html);
+}
