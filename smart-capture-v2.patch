+// Instagram's og:description looks like: '1,234 likes, 56 comments - user on March 3, 2025: "caption".'
+function cleanSocialCaption(platform: string, s: string): string {
+  if (!s) return s;
+  if (platform === "instagram") {
+    const m = s.match(/^[\d.,KkMm]+\s+likes?,\s*[\d.,KkMm]+\s+comments?\s*-\s*.+?\s+on\s+[^:]{3,40}:\s*["“]?([\s\S]*?)["”]?\.?$/);
+    if (m && m[1].trim().length > 3) return m[1].trim();
+  }
+  return s.replace(/\s+/g, " ").trim();
+}
