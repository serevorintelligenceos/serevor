+// ---------- platform detection ----------
+function detectPlatform(url: string): string {
+  try {
+    const u = new URL(url);
+    const h = u.hostname.replace(/^www\.|^m\./, "").toLowerCase();
+    if (h.endsWith("instagram.com")) return "instagram";
+    if (h === "youtu.be" || h.endsWith("youtube.com")) return "youtube";
+    if (h.endsWith("tiktok.com")) return "tiktok";
+    if (h.endsWith("facebook.com") || h === "fb.watch") return "facebook";
+    if (h === "x.com" || h.endsWith("twitter.com")) return "x";
+    if (h.endsWith("linkedin.com")) return "linkedin";
+    if (h.endsWith("reddit.com")) return "reddit";
+    if (h.endsWith("pinterest.com")) return "pinterest";
+    return "web";
+  } catch { return "web"; }
+}
+
+// ---------- YouTube: description + captions (best effort; YouTube may refuse server requests) ----------
+function youTubeId(url: string): string | null {
+  try {
+    const u = new URL(url);
+    const h = u.hostname.replace(/^www\.|^m\./, "").toLowerCase();
+    if (h === "youtu.be") return u.pathname.split("/")[1] || null;
+    const v = u.searchParams.get("v");
+    if (v) return v;
+    const m = u.pathname.match(/^\/(?:shorts|embed|live|v)\/([\w-]{6,20})/);
+    return m ? m[1] : null;
+  } catch { return null; }
