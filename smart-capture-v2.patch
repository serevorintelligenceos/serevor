+    const text = events.map((e) => (e.segs || []).map((s) => s.utf8 || "").join("")).join(" ")
+      .replace(/\[(?:Music|Applause|Laughter)\]/gi, " ").replace(/\s+/g, " ").trim();
+    if (text.length < 40) { out.status = "unavailable"; return out; }
+    out.transcript = text.slice(0, 60000);
+    out.lang = String(track.languageCode || "");
+    out.status = "ok";
+  } catch (err) {
+    console.warn("fetchYouTube failed:", (err as Error).message);
+    out.status = "unavailable";
+  }
+  return out;
+}
