+// Pulls the JSON object that starts at the first "{" at/after `from`, honouring strings.
+function extractJsonObject(text: string, from: number): string | null {
+  const start = text.indexOf("{", from);
+  if (start < 0) return null;
+  let depth = 0, inStr = false, esc = false;
+  for (let i = start; i < text.length; i++) {
+    const c = text[i];
+    if (inStr) {
+      if (esc) esc = false; else if (c === "\\") esc = true; else if (c === '"') inStr = false;
+      continue;
+    }
+    if (c === '"') inStr = true;
+    else if (c === "{") depth++;
+    else if (c === "}") { depth--; if (depth === 0) return text.slice(start, i + 1); }
+  }
+  return null;
+}
+interface YtInfo { title: string; author: string; description: string; transcript: string; lang: string; durationSec: number; status: "ok" | "unavailable" | "none" }
+async function fetchYouTube(url: string): Promise<YtInfo | null> {
+  const id = youTubeId(url);
+  if (!id) return null;
+  const out: YtInfo = { title: "", author: "", description: "", transcript: "", lang: "", durationSec: 0, status: "none" };
+  try {
+    const page = await safeFetch(`https://www.youtube.com/watch?v=${encodeURIComponent(id)}&hl=en`, { Cookie: "CONSENT=YES+1; SOCS=CAI", "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36" }, 3_000_000, 12000);
+    const at = page.text.indexOf("ytInitialPlayerResponse");
+    const raw = at >= 0 ? extractJsonObject(page.text, at) : null;
+    if (!raw) { out.status = "unavailable"; return out; }
+    const pr = JSON.parse(raw);
+    const vd = pr?.videoDetails || {};
+    out.title = String(vd.title || ""); out.author = String(vd.author || "");
+    out.description = String(vd.shortDescription || "").slice(0, 6000);
+    out.durationSec = Number(vd.lengthSeconds) || 0;
+    const tracks: Array<Record<string, unknown>> = pr?.captions?.playerCaptionsTracklistRenderer?.captionTracks || [];
+    if (!tracks.length) { out.status = "unavailable"; return out; }
+    const isAsr = (t: Record<string, unknown>) => t.kind === "asr";
+    const isEn = (t: Record<string, unknown>) => String(t.languageCode || "").toLowerCase().startsWith("en");
+    const track = tracks.find((t) => isEn(t) && !isAsr(t)) || tracks.find((t) => isEn(t)) || tracks.find((t) => !isAsr(t)) || tracks[0];
+    const base = String(track.baseUrl || "");
+    let capUrl: URL;
+    try { capUrl = new URL(base); } catch { out.status = "unavailable"; return out; }
+    if (!capUrl.hostname.endsWith("youtube.com")) { out.status = "unavailable"; return out; }
