+// ---------- page metadata ----------
+interface Meta {
+  title: string; author: string; caption: string; thumbnail: string; body: string; fetched: boolean;
+  yt: YtInfo | null;
+}
+async function fetchMeta(url: string, platform: string, wantYouTube: boolean): Promise<Meta> {
+  const meta: Meta = { title: "", author: "", caption: "", thumbnail: "", body: "", fetched: false, yt: null };
+  try {
+    if (platform === "youtube" || platform === "tiktok") {
+      const endpoint = platform === "youtube"
+        ? `https://www.youtube.com/oembed?format=json&url=${encodeURIComponent(url)}`
+        : `https://www.tiktok.com/oembed?url=${encodeURIComponent(url)}`;
+      try {
+        const r = await safeFetch(endpoint, {}, 100_000);
+        if (r.status === 200) {
+          const j = JSON.parse(r.text);
+          meta.title = String(j.title || ""); meta.author = String(j.author_name || ""); meta.thumbnail = String(j.thumbnail_url || "");
+          meta.fetched = true;
+        }
+      } catch { /* fall through to page fetch */ }
+    }
+    if (platform === "youtube" && wantYouTube) {
+      meta.yt = await fetchYouTube(url);
+      if (meta.yt) {
+        meta.title = meta.title || meta.yt.title;
+        meta.author = meta.author || meta.yt.author;
+        meta.fetched = meta.fetched || !!(meta.yt.title || meta.yt.description);
+      }
+    }
+    // YouTube pages are huge and carry no extra text for us; everything else gets the normal page fetch.
+    if (platform !== "youtube") {
+      const page = await safeFetch(url, {}, 2_500_000);
+      if (page.status >= 200 && page.status < 400 && /html|text/i.test(page.type || "text/html")) {
+        const og = (k: string) => metaTag(page.text, k);
+        const title = og("og:title") || og("twitter:title") || decode((page.text.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1] || "").trim());
+        const desc = og("og:description") || og("twitter:description") || og("description");
+        meta.title = meta.title || title;
+        meta.caption = cleanSocialCaption(platform, desc);
+        meta.author = meta.author || og("author") || og("article:author");
+        meta.thumbnail = meta.thumbnail || og("og:image");
+        if (!SOCIAL.has(platform) && platform !== "tiktok") {
+          meta.body = articleText(page.text).slice(0, 40000);
+        }
+        meta.fetched = meta.fetched || !!(title || desc || meta.body);
+      }
+    } else if (!meta.thumbnail) {
+      meta.thumbnail = `https://i.ytimg.com/vi/${youTubeId(url) || ""}/hqdefault.jpg`;
+    }
+  } catch (err) {
+    console.warn("fetchMeta failed:", (err as Error).message);
+  }
+  return meta;
+}
