new file mode 100644
index 0000000..cb91ec6
--- /dev/null
+++ b/supabase/migrations/20261015000000_smart_capture_limits.sql
@@ -0,0 +1,120 @@
+-- Smart Capture limits, enforced by the database so no client (or old app version) can bypass them.
+--   Captures: Free 10 / Pro 100 new captures per rolling 24 hours. The same number caps AI analyses.
+--   Folders:  Free 3 folders you create yourself / Pro unlimited. Smart folders (created by the capture
+--             function while it files an item) are not counted against that allowance.
+-- Keep these numbers in sync with src/lib/billing/plans.js.
+-- Errors use the app's existing convention: raise exception 'serevor_limit:<name>'.
+
+create or replace function public.capture_daily_cap(p_user uuid)
+returns integer language sql stable security definer set search_path to 'public' as $$
+  select case when public.billing_is_pro(p_user) then 100 else 10 end
+$$;
+revoke all on function public.capture_daily_cap(uuid) from public, anon, authenticated;
+
+-- 1) New captures. Every capture is written to the ai_usage ledger (which clients cannot read,
+--    change or delete), so deleting an item does not give the allowance back. The advisory lock
+--    makes parallel requests wait for each other, so they cannot slip past the cap together.
+create or replace function public.capture_items_guard()
+returns trigger language plpgsql security definer set search_path to 'public' as $$
+declare v_used integer;
+begin
+  perform pg_advisory_xact_lock(hashtextextended('serevor:capture:' || new.user_id::text, 0));
+  select count(*) into v_used from public.ai_usage
+   where user_id = new.user_id and kind = 'capture_new' and created_at > now() - interval '24 hours';
+  if v_used >= public.capture_daily_cap(new.user_id) then
+    raise exception 'serevor_limit:capture';
+  end if;
+  insert into public.ai_usage (user_id, kind) values (new.user_id, 'capture_new');
+  return new;
+end $$;
+revoke all on function public.capture_items_guard() from public, anon, authenticated;
+drop trigger if exists capture_items_guard_trg on public.knowledge_items;
+create trigger capture_items_guard_trg before insert on public.knowledge_items
+  for each row execute function public.capture_items_guard();
+
+-- 2) AI analyses: a backstop that decides Pro from billing_is_pro() (checked against now()), not from
+--    subscriptions.is_active, which is only recalculated when the subscription row is written.
+create or replace function public.ai_usage_capture_guard()
+returns trigger language plpgsql security definer set search_path to 'public' as $$
+declare v_used integer;
+begin
+  if new.kind = 'capture' then
+    perform pg_advisory_xact_lock(hashtextextended('serevor:analysis:' || new.user_id::text, 0));
+    select count(*) into v_used from public.ai_usage
+     where user_id = new.user_id and kind = 'capture' and created_at > now() - interval '24 hours';
+    if v_used >= public.capture_daily_cap(new.user_id) then
+      raise exception 'serevor_limit:capture';
+    end if;
+  end if;
+  return new;
+end $$;
+revoke all on function public.ai_usage_capture_guard() from public, anon, authenticated;
+drop trigger if exists ai_usage_capture_guard_trg on public.ai_usage;
+create trigger ai_usage_capture_guard_trg before insert on public.ai_usage
+  for each row execute function public.ai_usage_capture_guard();
+
+-- 3) Folders. Anything created through the app's API (anon/authenticated) is a folder the user made,
+--    whatever is_auto says, and a client can never flip a folder to is_auto = true to free a slot.
+--    Trusted callers (the capture edge function via the service role) create Smart folders.
+create or replace function public.collections_guard()
+returns trigger language plpgsql security definer set search_path to 'public' as $$
+declare
+  v_client boolean := coalesce(auth.role(), 'service_role') in ('authenticated', 'anon');
+  v_n integer;
+begin
+  if tg_op = 'UPDATE' then
+    if v_client and coalesce(new.is_auto, false) and not coalesce(old.is_auto, false) then
+      new.is_auto := false;
+    end if;
+    return new;
+  end if;
+  perform pg_advisory_xact_lock(hashtextextended('serevor:collections:' || new.user_id::text, 0));
+  if v_client then
+    new.is_auto := false;
+    select count(*) into v_n from public.collections where user_id = new.user_id and not coalesce(is_auto, false);
+    if public.billing_is_pro(new.user_id) then
+      if v_n >= 500 then raise exception 'serevor_limit:collections_max'; end if;
+    elsif v_n >= 3 then
+      raise exception 'serevor_limit:collections';
+    end if;
+  else
+    select count(*) into v_n from public.collections where user_id = new.user_id;
+    if v_n >= 60 then raise exception 'serevor_limit:collections_max'; end if;
+  end if;
+  return new;
+end $$;
+revoke all on function public.collections_guard() from public, anon, authenticated;
+drop trigger if exists collections_guard_trg on public.collections;
+create trigger collections_guard_trg before insert or update on public.collections
+  for each row execute function public.collections_guard();
+
+-- 4) What the app shows ("7 of 10 captures today"). Read-only.
+create or replace function public.my_capture_quota()
+returns jsonb language plpgsql stable security definer set search_path to 'public' as $$
+declare v_uid uuid := auth.uid(); v_pro boolean; v_oldest timestamptz;
+begin
+  if v_uid is null then
+    return jsonb_build_object('pro', false, 'captures_used', 0, 'captures_cap', 10, 'analyses_used', 0,
+      'resets_at', null, 'folders_used', 0, 'folders_cap', 3, 'max_slides', 10);
+  end if;
+  v_pro := public.billing_is_pro(v_uid);
+  select min(created_at) into v_oldest from public.ai_usage
+   where user_id = v_uid and kind = 'capture_new' and created_at > now() - interval '24 hours';
+  return jsonb_build_object(
+    'pro', v_pro,
+    'captures_used', (select count(*) from public.ai_usage where user_id = v_uid and kind = 'capture_new' and created_at > now() - interval '24 hours'),
+    'captures_cap', case when v_pro then 100 else 10 end,
+    'analyses_used', (select count(*) from public.ai_usage where user_id = v_uid and kind = 'capture' and created_at > now() - interval '24 hours'),
+    'resets_at', case when v_oldest is null then null else v_oldest + interval '24 hours' end,
+    'folders_used', (select count(*) from public.collections where user_id = v_uid and not coalesce(is_auto, false)),
+    'folders_cap', case when v_pro then null else 3 end,
+    'max_slides', 10);
+end $$;
+revoke all on function public.my_capture_quota() from public, anon;
+grant execute on function public.my_capture_quota() to authenticated;
+
+-- 5) Count captures made in the last 24h before this migration, so the day's allowance starts honest.
+insert into public.ai_usage (user_id, kind, created_at)
+select k.user_id, 'capture_new', k.captured_at from public.knowledge_items k
+ where k.captured_at > now() - interval '24 hours'
+   and not exists (select 1 from public.ai_usage u where u.kind = 'capture_new');
