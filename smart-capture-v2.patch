+
+// ---------- model call ----------
+function parseJson(raw: string): Record<string, unknown> | null {
+  try { return JSON.parse(raw); } catch { /* try to find the object */ }
+  const s = raw.indexOf("{"), e = raw.lastIndexOf("}");
+  if (s >= 0 && e > s) { try { return JSON.parse(raw.slice(s, e + 1)); } catch { /* ignore */ } }
+  return null;
+}
+async function askJson(key: string, system: string, user: string): Promise<Record<string, unknown>> {
+  // 1st try: JSON mode + medium reasoning (best quality). 2nd try: plain + low reasoning (cheaper, resilient).
+  const attempts = [{ format: true, effort: "medium", tokens: 6500 }, { format: false, effort: "low", tokens: 5000 }];
+  let lastErr = "";
+  for (const a of attempts) {
+    const res = await fetch(GROQ_URL, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
+      signal: AbortSignal.timeout(70000),
+      body: JSON.stringify({
+        model: MODEL, temperature: 0.2, reasoning_effort: a.effort, max_completion_tokens: a.tokens,
+        ...(a.format ? { response_format: { type: "json_object" } } : {}),
+        messages: [{ role: "system", content: system }, { role: "user", content: user }],
+      }),
+    });
+    if (!res.ok) {
+      const t = await res.text();
+      lastErr = `Groq ${res.status} (${MODEL}): ${t.slice(0, 250)}`;
+      if (res.status === 400 || res.status === 422) continue; // model may not support these options: retry plain
+      throw new Error(lastErr);
+    }
+    const data = await res.json();
+    const parsed = parseJson(data.choices?.[0]?.message?.content || "");
+    if (parsed) return parsed;
+    lastErr = "Model did not return valid JSON";
+  }
+  throw new Error(lastErr || "Model did not return valid JSON");
+}
